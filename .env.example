# 复制本文件为 .env 并填入你的 Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选: 覆盖默认模型 (默认 claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# 可选: 运行时数据目录 (默认 ./data)
# DATA_DIR=./data

# 可选: 元数据存储后端 file(默认,JSON 文件) | sql
# STORAGE_BACKEND=sql
# SQL 后端连接串 (默认本地 SQLite,无需外部服务)。生产可换 Postgres:
# DATABASE_URL=postgresql+psycopg://user:pwd@localhost:5432/drawings
# DATABASE_URL=sqlite:///./data/app.db

# ---- 二进制对象存储后端 ----
# local(默认,落本地磁盘) | s3 / minio(私有化集群/多节点共享,需 pip install boto3)
# BLOB_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000     # MinIO 端点; 用 AWS S3 时留空
# S3_BUCKET=drawings
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_PREFIX=                            # 对象 key 前缀(多租户/多环境隔离,可选)

# ---- 鉴权 / RBAC(私有化部署) ----
# 默认关闭(行为与之前一致,隐式 system/admin)。私有化部署置 true 开启登录+角色权限。
# AUTH_ENABLED=true
# 令牌签名密钥: 开启鉴权时务必改成随机长串(例如 `openssl rand -hex 32`)
# AUTH_SECRET=change-me-to-a-long-random-string
# 令牌有效期(小时,默认 12)
# TOKEN_TTL_HOURS=12
# 首次启动自动创建的管理员(请尽快用其登录后改密/建号)
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=admin123

# ============================================================================
# Docker Compose 一键私有化部署专用(本地 python 运行可忽略;见 DEPLOY.md)
# docker compose 会自动加载本目录的 .env 做变量插值。生产请改掉所有默认密码!
# ============================================================================
# ANTHROPIC_API_KEY 与上面的同名变量复用(容器内由 compose 注入)
# AUTH_SECRET=请改成随机长串-openssl-rand-hex-32
# POSTGRES_PASSWORD=drawings_pwd
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=drawings
# DEFAULT_ADMIN_PASSWORD=admin123
# TASK_WORKERS=4
