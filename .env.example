# 复制本文件为 .env 并填入你的 Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选: 覆盖默认模型 (默认 claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# OpenAI 可选配置 (LLM_PROVIDER=openai 时使用)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5.6
# 如需显式指定本地 HTTP 代理（例如 Clash），填写下行；未设置时复用 HTTPS_PROXY。
# OPENAI_PROXY_URL=http://127.0.0.1:7890
# OPENAI_TIMEOUT_SECONDS=180
# OpenAI 使用后台任务并短轮询，避免代理中断长时间无响应的图纸解析。
# OPENAI_BACKGROUND_TIMEOUT_SECONDS=600
# 成本保护：默认均为 0 / 8000，通常无需填写。
# OPENAI_MAX_RETRIES=0
# OPENAI_SCHEMA_REPAIR_RETRIES=0
# OPENAI_MAX_OUTPUT_TOKENS=8000
# 图纸视觉 / 纯文本任务的单次输出上限；图纸复杂时可把视觉上限设为 8000。
# OPENAI_VISION_MAX_OUTPUT_TOKENS=6000
# OPENAI_TEXT_MAX_OUTPUT_TOKENS=3000
# OPENAI_TEXT_MODEL=gpt-5.6
# GPT-5 / o 系列默认使用 low，减少推理 token 与等待时间；留空则交给模型默认值。
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_TOOL_CALLS=1

# Qwen / 阿里云百炼（LLM_PROVIDER=qwen 时使用；不会影响现有 OpenAI 路径）
# 先在百炼控制台的“视觉模型”启用 qwen3-vl-flash，并在 API Key 页面创建 Key。
# 不要把 Key 发到聊天中，只填入本机 .env。
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 推荐填写北京业务空间专属域名：把 <WorkspaceId> 替换为控制台业务空间详情中的 ID。
# QWEN_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-vl-flash
# 视觉模型按顺序自动切换：仅在当前模型返回 403/429（未开通、额度耗尽或限流）时
# 才会尝试下一个；请只填写控制台中已启用且有额度的视觉模型。
# QWEN_VISION_MODELS=qwen3-vl-flash,qwen3-vl-32b-thinking
# 纯文本工艺/报价/技术文档提取任务使用非视觉模型，避免消耗 VL 模型额度。
# 请填入你在百炼已开通的文本模型；例如：QWEN_TEXT_MODEL=qwen-plus-2025-07-28
# QWEN_TEXT_MODELS=qwen-plus-2025-07-28,qwen3.7-plus,qwen-max
# 型号联网核验使用原生 DashScope 搜索 API，以保留每次搜索的真实来源链接；
# 建议使用已开通的 qwen-plus。候选模型只在 403/404/429 时自动切换。
# QWEN_WEB_SEARCH_MODEL=qwen-plus
# QWEN_WEB_SEARCH_MODELS=qwen-plus,qwen3.7-plus,qwen3.5-plus
# 使用业务空间专属地址时可显式填写；未设置时会从 QWEN_BASE_URL 自动换算。
# QWEN_DASHSCOPE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# QWEN_PROXY_URL=http://127.0.0.1:7890
# QWEN_TIMEOUT_SECONDS=180
# 默认禁用思考，避免图纸 JSON 任务额外消耗思维链 token。
# QWEN_ENABLE_THINKING=false
# QWEN_MAX_RETRIES=0
# QWEN_MAX_OUTPUT_TOKENS=6000
# QWEN_VISION_MAX_OUTPUT_TOKENS=6000
# QWEN_TEXT_MAX_OUTPUT_TOKENS=3000
# 佐证附件只会以此预算发送给模型；原文件仍完整保存在项目中。
# LLM_MAX_ATTACHMENTS=3
# LLM_MAX_ATTACHMENT_TEXT_CHARS=12000
# LLM_MAX_ATTACHMENT_IMAGE_BYTES=5242880
# HTTP 上传的单文件上限（字节）；原文件完整保存，和上面“发送给模型”的预算无关。
# MAX_UPLOAD_BYTES=52428800

# 可选: 运行时数据目录 (默认 ./data)
# DATA_DIR=./data

# 可选: 元数据存储后端 file(默认,JSON 文件) | sql
# STORAGE_BACKEND=sql
# SQL 后端连接串 (默认本地 SQLite,无需外部服务)。生产可换 Postgres:
# DATABASE_URL=postgresql+psycopg://user:pwd@localhost:5432/drawings
# DATABASE_URL=sqlite:///./data/app.db

# ---- 二进制对象存储后端 ----
# local(默认,落本地磁盘) | s3 / minio(私有化集群/多节点共享,需 pip install boto3)
# BLOB_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000     # MinIO 端点; 用 AWS S3 时留空
# S3_BUCKET=drawings
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_PREFIX=                            # 对象 key 前缀(多租户/多环境隔离,可选)

# ---- 鉴权 / RBAC(私有化部署) ----
# 默认关闭(行为与之前一致,隐式 system/admin)。私有化部署置 true 开启登录+角色权限。
# AUTH_ENABLED=true
# 令牌签名密钥: 开启鉴权时务必改成随机长串(例如 `openssl rand -hex 32`)
# AUTH_SECRET=change-me-to-a-long-random-string
# 令牌有效期(小时,默认 12)
# TOKEN_TTL_HOURS=12
# 连续失败登录的限流阈值与统计窗口(秒)
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=600
# 首次启动自动创建的管理员(请尽快用其登录后改密/建号)
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=admin123
# 同源访问无需填写；跨域控制台必须显式填写实际前端域名，默认不允许跨域。
# CORS_ALLOW_ORIGINS=https://your-console.example.com
# 单实例重启时将中断的进程内任务标记为失败；多副本外部队列场景应设为 false。
# TASK_RECOVER_ON_START=true

# ============================================================================
# Docker Compose 一键私有化部署专用(本地 python 运行可忽略;见 DEPLOY.md)
# docker compose 会自动加载本目录的 .env 做变量插值。以下安全变量均为必填项。
# ============================================================================
# ANTHROPIC_API_KEY 与上面的同名变量复用(容器内由 compose 注入)
# AUTH_SECRET=请填入openssl-rand-hex-32的输出
# POSTGRES_PASSWORD=请填入强密码(仅使用URL安全字符)
# S3_ACCESS_KEY=请填入对象存储账号
# S3_SECRET_KEY=请填入对象存储强密钥
# S3_BUCKET=drawings
# DEFAULT_ADMIN_PASSWORD=请填入管理员强密码
# TASK_WORKERS=4
